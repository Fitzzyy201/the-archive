# Database Configuration
DATABASE_URL="mysql://root:password@localhost:3306/nama_database"

# Application Config
PORT=3001
FRONTEND_URL=http://localhost:3000

# Authentication / JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Midtrans Sandbox Credentials
MIDTRANS_SERVER_KEY=your_midtrans_sandbox_server_key
MIDTRANS_CLIENT_KEY=your_midtrans_sandbox_client_key
MIDTRANS_IS_PRODUCTION=false

# SMTP / Email Service
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM="The Archive <your_email@gmail.com>"

# Environment
NODE_ENV=development
