generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role{
  Admin
  Buyer
  Seller
}

enum StatusAkun {
  Aktif
  Suspend
}

enum StatusVerif {
  Pending
  Approved
  Rejected
}

enum StatusProduk {
  Aktif
  Nonaktif
}

enum StatusPesanan {
  BelumBayar
  Diproses
  Dikirim
  Selesai
  Dikomplain
  Batal
}

enum StatusKomplain {
  Menunggu
  DalamProses
  Disetujui
  Ditolak
}

enum JenisTransaksi {
  PencairanSeller
  FeeAdmin
  RefundBuyer
  WithdrawAdmin
}

model User {
  id          Int        @id @default(autoincrement()) @map("id_user")
  nama        String?    @db.VarChar(100)
  email       String     @unique @db.VarChar(100)
  password    String     @db.VarChar(255)
  role        Role       @default(Buyer)
  username    String?    @unique
  statusAkun  StatusAkun @default(Aktif) @map("status_akun")
  noTelp      String     @map("no_telp") @db.VarChar(20)
  fotoProfil  String?    @map("foto_profil") @db.VarChar(255)
  otpCode     String?    
  otpExpires  DateTime?

  toko             TokoSeller?       @relation("PemilikToko")
  tokoDiverifikasi TokoSeller[]      @relation("AdminPemeriksa")
  alamatPengiriman AlamatPengiriman[]
  cart             Cart[]
  transaksiBuyer   Transaksi[]       @relation("BuyerTransaksi")
  komplainDitangani Komplain[]       @relation("AdminKomplain")
  logKeuangan      LogKeuangan[]
  ulasanDiberikan Ulasan[] @relation("BuyerUlasan")

  @@map("user")
}

model TokoSeller {
  id              Int         @id @default(autoincrement()) @map("id_toko")
  userId          Int         @unique @map("id_user")
  diperiksaOleh   Int?        @map("diperiksa_oleh")
  namaToko        String      @map("nama_toko") @db.VarChar(100)
  fotoToko        String?     @map("foto_toko") @db.LongText
  kota            String      @db.VarChar(100)
  noTelp          String?     @map("no_telp") @db.VarChar(20)
  noRekening      String      @map("no_rekening") @db.VarChar(50)
  fotoKtp         String?     @map("foto_ktp") @db.LongText
  fotoSkck        String?     @map("foto_skck") @db.LongText
  statusVerif     StatusVerif @default(Pending) @map("status_verif")
  alasanPenolakan String?     @map("alasan_penolakan") @db.Text
  saldoToko       Int         @default(0) @map("saldo_toko")

  // Relasi
  user      User      @relation("PemilikToko", fields: [userId], references: [id])
  admin     User?     @relation("AdminPemeriksa", fields: [diperiksaOleh], references: [id])
  produk    Produk[]
  transaksi Transaksi[]

  @@map("toko_seller")
}

model Produk {
  id            Int          @id @default(autoincrement()) @map("id_produk")
  tokoId        Int          @map("id_toko")
  namaProduk    String       @map("nama_produk") @db.VarChar(150)
  deskripsi     String       @db.Text
  harga         Int
  stok          Int
  ukuranDimensi String       @map("ukuran_dimensi") @db.VarChar(50)
  fotoProduk    String       @map("foto_produk") @db.LongText
  defect        Boolean      @default(false)
  statusProduk  StatusProduk @default(Aktif) @map("status_produk")

  // Relasi
  toko TokoSeller @relation(fields: [tokoId], references: [id])
  cart Cart[]
  ulasan Ulasan[]

  @@map("produk")
}

model AlamatPengiriman {
  id            Int    @id @default(autoincrement()) @map("id_alamat")
  userId        Int    @map("id_user")
  namaPenerima  String @map("nama_penerima") @db.VarChar(100)
  kotaPenerima  String @map("kota_penerima") @db.VarChar(100)
  alamatLengkap String @map("alamat_lengkap") @db.Text
  catatanKurir  String? @map("catatan_kurir") @db.Text

  user User @relation(fields: [userId], references: [id])

  @@map("alamat_pengiriman")
}

model Cart {
  id       Int @id @default(autoincrement()) @map("id_cart")
  produkId Int @map("id_produk")
  userId   Int @map("id_user")
  qty      Int

  produk Produk @relation(fields: [produkId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@map("cart")
}

model Transaksi {
  id            Int           @id @default(autoincrement()) @map("id_transaksi")
  buyerId       Int           @map("id_buyer")
  tokoId        Int           @map("id_toko")
  totalHarga    Int           @map("total_harga")
  statusPesanan StatusPesanan @default(BelumBayar) @map("status_pesanan")
  
  waktuTransaksi        DateTime  @default(now()) @map("waktu_transaksi")
  batasWaktuTransaksi   DateTime? @map("batas_waktu_transaksi") // Buat Cron Job 15 Menit
  batasWaktuKomplain    DateTime? @map("batas_waktu_komplain")  // Buat Cron Job 2x24 Jam

  // Relasi
  buyer       User          @relation("BuyerTransaksi", fields: [buyerId], references: [id])
  toko        TokoSeller    @relation(fields: [tokoId], references: [id])
  komplain    Komplain?
  logKeuangan LogKeuangan[]

  @@map("transaksi")
}

model Komplain {
  id              Int            @id @default(autoincrement()) @map("id_komplain")
  transaksiId     Int            @unique @map("id_transaksi")
  ditanganiOleh   Int?           @map("ditangani_oleh")
  alasanKomplain  String         @map("alasan_komplain") @db.Text
  fotoVideoBukti  String         @map("foto_video_bukti") @db.VarChar(255)
  statusKomplain  StatusKomplain @default(Menunggu) @map("status_komplain")
  keputusanAdmin  String?        @map("keputusan_admin") @db.Text

  transaksi Transaksi @relation(fields: [transaksiId], references: [id])
  admin     User?     @relation("AdminKomplain", fields: [ditanganiOleh], references: [id])

  @@map("komplain")
}

model LogKeuangan {
  id            Int            @id @default(autoincrement()) @map("id_log")
  transaksiId   Int?           @map("id_transaksi")
  userId        Int            @map("id_user")
  jenisTransaksi JenisTransaksi @map("jenis_transaksi")
  nominal       Int
  waktuLog      DateTime       @default(now()) @map("waktu_log")

  transaksi Transaksi? @relation(fields: [transaksiId], references: [id])
  user      User       @relation(fields: [userId], references: [id])

  @@map("log_keuangan")
}

model Ulasan {
  id        Int      @id @default(autoincrement()) @map("id_ulasan")
  buyerId   Int      @map("id_buyer")
  produkId  Int      @map("id_produk")
  rating    Int
  komentar  String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  // Relasi
  buyer  User   @relation("BuyerUlasan", fields: [buyerId], references: [id])
  produk Produk @relation(fields: [produkId], references: [id])

  @@map("ulasan")
}